{
  "name": "modern-notes-saas",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply notes_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply notes_db --remote",
    "test": "vitest run --config vite.config.ts && vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest --config vite.config.ts",
    "lint": "tsc --noEmit",
    "verify:deploy": "node scripts/verify-deploy-readiness.mjs",
    "verify:deploy:online": "node scripts/verify-deploy-readiness.mjs --online",
    "smoke:daily-visible": "node scripts/smoke-daily-log-visible.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "framer-motion": "^12.12.1",
    "lucide-react": "^0.511.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.0",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260417.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4",
    "wrangler": "^4.14.4"
  }
}
